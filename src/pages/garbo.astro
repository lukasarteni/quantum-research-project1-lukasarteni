---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import { Button } from "free-astro-components";
import { Image } from "astro:assets";
import chshimage from "../../src/content/blog/Chsh-illustration2.png";
import chshimage2 from "../../src/content/blog/chshBases.png";
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />
    <main>
      <h1>CHSH Tinkerer</h1><br />
      <div id="myDiv2"></div>
      <script src="http://d3js.org/d3.v7.min.js" charset="utf-8"></script>

      <script src="../../src/components/examplechart2.js"></script>
      <svg id="test1"></svg>
      <script>
        const svg = d3.select("#test1");
        svg
          .append("circle")
          .attr("cx", 10)
          .attr("cy", 20)
          .attr("r", 40)
          .style("fill", "blue");
      </script>

      
      <Footer />
    </main>
    <br />
  </body>
</html>
