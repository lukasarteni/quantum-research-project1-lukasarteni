---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import { Button } from "free-astro-components";
import { Image } from "astro:assets";
import chshimage from "../../src/content/blog/Chsh-illustration2.png";
import chshimage2 from "../../src/content/blog/chshBases.png";
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC"
      crossorigin="anonymous"
    />
  </head>
  <body>
    <Header />
    <main>
      <h1>CHSH Tinkerer</h1><br />

      <p>chart:</p>
      
      




      <label for="SelectorForGraph1">Options:</label>
					<select id="SelectorForGraph1" name="SelectorForGraph1">
						<option value="1">x = 0, y = 0</option>
						<option value="2">x = 0, y = 1</option>
						<option value="3" >x = 1, y = 0</option>
						<option value="4" >x = 1, y = 1</option>
					</select>


      <Footer />
    </main>
    <br />
  </body>
</html>

