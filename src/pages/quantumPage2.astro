---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
//import react from "@astrojs/react";
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<div
				style="display:flex; align-items:center; justify-content:center;"
			>
				<h1>CHSH Tinkerer</h1><br />
			</div>

			<div
				style="display:flex; align-items:center; justify-content:center;"
			>
				<h2>Quantum Entanglement<br />Strategy Tinkerer</h2>
			</div>
			<p>
				&vert;A<sub>0</sub>&rangle; = cos(&alpha;)&vert;0&rangle; +
				sin(&alpha;)&vert;1&rangle; and &vert;B<sub>0</sub>&rangle; =
				cos(&beta;)&vert;0&rangle; + sin(&beta;)&vert;1&rangle;
			</p>
			<div>
				<label>Alpha angle (degrees):</label>
				<input type="number" class="alpha" value="0" id="hi" />
				<br />
				Choose angle between &vert;A<sub>0</sub>&rangle; and &vert;A<sub
					>1</sub
				>&rangle; :

				<label>
					<input
						type="radio"
						name="alphadiffangle"
						value="+90"
						checked
					/>
					+90°
				</label>
				<label>
					<input
						type="radio"
						name="alphadiffangle"
						value="-90"
						disabled
					/>
					-90°
				</label>
				<br />
				<br />
				<div>
					<label>Beta angle (degrees):</label>
					<input type="number" class="Beta" value="45" name="hi" />
					<br />
					Choose angle between &vert;B<sub>0</sub>&rangle; and &vert;B<sub
						>1</sub
					>&rangle; :

					<input
						type="radio"
						name="betadiffangle"
						value="+90"
						checked
					/>
					+90°

					<label>
						<input
							type="radio"
							name="betadiffangle"
							value="-90"
							disabled
						/>
						-90°
					</label>
				</div>
				<button name="Submit" id="buttonUpdater"
					>Update With New Values</button
				>
			</div>
			<div>
				<p>hi</p>
				<button id="moreButton"> MORE!</button>
				<br />

				<svg id="dataviz_area" height="300" width="450"></svg>

				<script src="http://d3js.org/d3.v7.min.js" charset="utf-8"
				></script>

				<script>
					const svg = d3.select("#dataviz_area");
					const width = +svg.attr("width");
					const height = +svg.attr("height");
					const margin = 40;
					const centerX = width / 2;
					const centerY = height / 2;
					const scale = 100; // pixels per unit

					// Draw arrow marker
					svg.append("defs")
						.append("marker")
						.attr("id", "arrow")
						.attr("viewBox", "0 -5 10 10")
						.attr("refX", 10)
						.attr("refY", 0)
						.attr("markerWidth", 6)
						.attr("markerHeight", 6)
						.attr("orient", "auto")
						.append("path")
						.attr("d", "M0,-5L10,0L0,5")
						.attr("fill", "black");

					// Draw axes
					svg.append("line")
						.attr("x1", centerX)
						.attr("y1", margin)
						.attr("x2", centerX)
						.attr("y2", height - margin)
						.attr("stroke", "black");

					svg.append("line")
						.attr("x1", margin)
						.attr("y1", centerY)
						.attr("x2", width - margin)
						.attr("y2", centerY)
						.attr("stroke", "black");

					// Function to draw vector
					function drawVector(x, y, color, label) {
						svg.append("line")
							.attr("x1", centerX)
							.attr("y1", centerY)
							.attr("x2", centerX + x * scale)
							.attr("y2", centerY - y * scale)
							.attr("stroke", color)
							.attr("class", "vector");

						svg.append("text")
							.attr("x", centerX + x * scale + 5)
							.attr("y", centerY - y * scale + 5)
							.text(label)
							.style("font-size", "14px");
					}

					// Plot |0⟩ and |1⟩
					drawVector(1, 0, "blue", "|0⟩");
					drawVector(0, 1, "red", "|1⟩");

					document
						.getElementById("buttonUpdater")
						.addEventListener("click", () => {
							alert("sup");
							const math = require('mathjs')

							const A = math.matrix([[[0], [1]]]);
							const B = [[0], [1]];

							const transposed = math.transpose(A);
							const product = math.multiply(A, B);
							alert(product);
						});
					document
						.getElementById("moreButton")
						.addEventListener("click", () => {
							drawVector(
								0.707106781,
								0.707106781,
								"green",
								"|+⟩",
							);
							drawVector(
								0.707106781,
								-0.707106781,
								"brown",
								"|-⟩",
							);
						});
				</script>
			</div>
		</main>
		<Footer />
	</body>
</html>
